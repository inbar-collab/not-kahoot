# --- Supabase (Project Settings -> API Keys / Data API) ---
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# The public "anon" key (or the newer "publishable" key, sb_publishable_...).
# Safe to expose: the database gives it access to nothing except change signals.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The secret "service_role" key (or the newer "secret" key, sb_secret_...).
# SERVER ONLY. Never share it, never put it in a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
# The address people will open, without a trailing slash.
# Locally: http://localhost:3000   On Vercel: https://your-project.vercel.app
APP_BASE_URL=http://localhost:3000

# --- AI quiz builder (optional; see README section 3) ---
# Free key from https://aistudio.google.com/apikey (keep billing off to stay free).
GEMINI_API_KEY=
# Optional. Defaults to gemini-flash-latest (the newest free Flash model).
GEMINI_MODEL=
# Development only: 1 = a scripted AI chat, no key needed.
AI_MOCK=
