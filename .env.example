# --- Supabase (Project Settings -> API) ---
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# The public "anon" key (or the newer "publishable" key, sb_publishable_...).
# Safe to expose: the database gives it access to nothing except change signals.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The secret "service_role" key (or the newer "secret" key, sb_secret_...).
# SERVER ONLY. Never share it, never put it in a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
# The address people will open, without a trailing slash.
# Locally: http://localhost:3000   On Vercel: https://your-project.vercel.app
APP_BASE_URL=http://localhost:3000

# Password for creating new games from the home page. Pick anything long.
# Leave empty to disable creating games from the website (use `npm run seed`).
HOST_PASSWORD=
